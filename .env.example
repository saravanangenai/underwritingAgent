# Copy to .env. Structured JSON submissions need no keys; `acord_text` needs at least one LLM key.
DATABASE_URL=sqlite+aiosqlite:///./underwriting.db
# CORS_ORIGINS=["http://localhost:5173"]

# LLM providers: any with a key is used, tried in LLM_PROVIDERS order.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDERS=["groq","gemini","openai"]
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-5.4-mini
# LLM_TIMEOUT_SECONDS=60
# LLM risk review after the rules (one extra LLM call per submission). false = rules only.
# LLM_RISK_ASSESSMENT=true

# Hazard data: FEMA National Risk Index through the Apify MCP server when APIFY_TOKEN is set.
# Each lookup is one billed Apify Actor run (about $0.006 on the free tier).
# HAZARD_PROVIDER=mock forces the mock (no cost; matches the documented sample outcomes).
# APIFY_TOKEN=
# HAZARD_PROVIDER=apify
# APIFY_MCP_URL=https://mcp.apify.com
# APIFY_HAZARD_ACTOR=malonestar/fema-nri-county-risk-profile
# APIFY_HAZARD_RESOLUTION=tract
# APIFY_TIMEOUT_SECONDS=120
# HAZARD_PROVIDER=mock
