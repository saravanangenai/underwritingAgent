# Copy to .env. Structured JSON submissions need no keys; `acord_text` needs at least one LLM key.
DATABASE_URL=sqlite+aiosqlite:///./underwriting.db
# CORS_ORIGINS=["http://localhost:5173"]

# LLM providers: any with a key is used, tried in LLM_PROVIDERS order.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDERS=["groq","gemini","openai"]
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# OPENAI_MODEL=gpt-5.4-mini
# LLM_TIMEOUT_SECONDS=60

# Phase 3
# APIFY_TOKEN=
# APIFY_MCP_URL=
