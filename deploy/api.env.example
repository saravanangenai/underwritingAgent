# Production settings for the API. install.sh copies this to /etc/underwriting-agent/api.env
# (owner root, group underwriting, mode 640) the first time; fill in the keys there.
# Never commit the real file.

DATABASE_URL=sqlite+aiosqlite:////var/lib/underwriting-agent/underwriting.db
COOKIE_SECURE=true
SESSION_HOURS=12

# LLM providers (use separate production keys from your laptop's).
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDERS=["groq","gemini"]

# Hazard data: set APIFY_TOKEN for live FEMA data (about $0.006 per submission), or keep mock.
HAZARD_PROVIDER=mock
APIFY_TOKEN=

# Same origin in production (Caddy), so no cross-origin browser access is needed.
CORS_ORIGINS=[]
