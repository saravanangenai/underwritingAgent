# Files that run on the Linux server must keep Unix line endings, even when checked out on
# Windows (bash and systemd fail on \r\n).
*.sh            text eol=lf
deploy/uw-users text eol=lf
deploy/Caddyfile text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
deploy/systemd/*.conf text eol=lf
deploy/*.example text eol=lf
