{
  "name": "underwriting-workbench",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Vue workbench for underwriters: the submission queue, decisions with cited flags, and the audit trail.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^24.1.3",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
